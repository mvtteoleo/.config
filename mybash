# SOURCE OPENFOAM
of12() {
  local foam_bash=~/OpenFOAM/OpenFOAM-12/etc/bashrc
  if [[ -f "$foam_bash" ]]; then
    source "$foam_bash"
    export LD_PATH_BACKUP=$LD_LIBRARY_PATH
    echo "✅ OpenFOAM 12 environment loaded"
  else
    echo "❌ Error: $foam_bash not found"
  fi
}

# Source python
PYTHON() {
  local py_activate=~/py/bin/activate
  if [[ -f "$py_activate" ]]; then
    source "$py_activate"
    echo "✅ Python venv loaded"
  else
    echo "❌ Error: $py_activate not found"
  fi
}

# mk.
export mkPrefix=/u/sw/

# Functions
# module load package_name
LOAD_MODULES() {
    local qui=$PWD 
    source ${mkPrefix}/etc/profile
    module load gcc-glibc
    module load fftw
    module load boost
    cd /home/matteo/Sharedssd/università/5AnnoAer/pacs/pacs-examples 
    source load_modules.sh
    cd - > /dev/null
    cd ${qui}  > /dev/null || echo "Non riesco a tornare ${qui}"
} 


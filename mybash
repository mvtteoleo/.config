# starship for cool CLI
export starship=/usr/local/bin
alias starship='/usr/local/bin/starship'
eval "$(starship init bash)"

expand_swap(){
sudo fallocate -l 16G /swapfile
sudo chmod 600 /swapfile
sudo mkswap /swapfile
sudo swapon /swapfile
}

clean() {
if [ -n "$LD_LIBRARY_PATH" ]; then
    echo  -e "⚠️  Warning: LD_LIBRARY_PATH is set to : (\n $LD_LIBRARY_PATH \n), moving it to LD_PATH_BACKUP"
    export LD_PATH_BACKUP=$LD_LIBRARY_PATH
    export LD_PATH_BACKUP=""
    echo "✅ Environment cleaned"
else
    echo "✅ Already clean environment"
fi
}

monta(){
    sudo mount $MEMOCOMUNE $MONTA 
    systemctl daemon-reload 
    echo "✅ Memoria montata."
}

# Start terminal
ciao() {
    if ! mountpoint -q "$MONTA"; then
        monta
    else
        echo "Memo già montata."
    fi
